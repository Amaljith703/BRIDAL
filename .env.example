# Copy to .env and change every secret before deploying.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# SQL Server (Docker)
MSSQL_SA_PASSWORD=MakeupArt!Dev2026Sql
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=127.0.0.1,1434;Database=MakeupArtDb;User Id=sa;Password=MakeupArt!Dev2026Sql;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True

# JWT / auth
JWT__ISSUER=MakeupArtApi
JWT__AUDIENCE=MakeupArtClient
JWT__SIGNINGKEY=CHANGE_ME_TO_A_LONG_RANDOM_DEVELOPMENT_KEY_AT_LEAST_64_CHARS
SEED__ADMINEMAIL=admin@makeupart.local
SEED__ADMINPASSWORD=MakeupArt@Admin123!

# Frontend
FRONTEND_ORIGIN=http://localhost:4200

# Razorpay (optional in dev; mock provider is used when blank)
RAZORPAY__KEYID=
RAZORPAY__KEYSECRET=
RAZORPAY__WEBHOOKSECRET=
PAYMENTS__DEFAULTPROVIDER=Mock

# SMTP (optional; emails are logged to disk when blank)
SMTP__HOST=
SMTP__PORT=587
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROMEMAIL=hello@makeupart.local
SMTP__FROMNAME=Makeup Art

# AI (Ollama)
AI__ENABLED=true
AI__BASEURL=http://localhost:11434
AI__MODEL=qwen3.5:latest

# Backups
BACKUP__CONTAINERPATH=/var/opt/mssql/backups
BACKUP__HOSTPATH=E:\openCode\Makeup Art\database\backups
BACKUP__RETENTIONDAYS=14
